generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  password         String
  role             String             @default("END_USER")
  officeId         String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  auditLogs        DocumentAuditLog[]
  purchaseRequests PurchaseRequest[]
  office           Office?            @relation(fields: [officeId], references: [id])

  @@map("users")
}

model Office {
  id               String            @id @default(cuid())
  name             String            @unique
  code             String            @unique
  head             String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[]
  signatories      Signatory[]
  users            User[]

  @@map("offices")
}

model Signatory {
  id               String            @id @default(cuid())
  name             String
  position         String
  officeId         String?
  role             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[] @relation("PrRequestedBy")
  rfqs             Rfq[]
  office           Office?           @relation(fields: [officeId], references: [id])

  @@map("signatories")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  philgepsNo     String?
  tin            String?
  address        String?
  contactPerson  String?
  contactNumber  String?
  email          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  quotations     Quotation[]
  rfqSuppliers   RfqSupplier[]

  @@map("suppliers")
}

model Item {
  id           String       @id @default(cuid())
  code         String?      @unique
  description  String
  unit         String
  standardCost Float        @default(0)
  category     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  prLineItems  PrLineItem[]

  @@map("items")
}

model FundSource {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  description      String?
  fiscalYear       Int
  totalBudget      Float             @default(0)
  usedBudget       Float             @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[]

  @@map("fund_sources")
}

model PurchaseRequest {
  id                     String       @id @default(cuid())
  prNumber               String       @unique
  officeId               String
  requestedById          String
  requestedBySignatoryId String?
  purpose                String
  fundSourceId           String?
  chargeToAccount        String?
  totalAmount            Float        @default(0)
  status                 String       @default("DRAFT")
  remarks                String?
  printCount             Int          @default(0)
  lastPrintedAt          DateTime?
  lastPrintedBy          String?
  fiscalYear             Int
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  lineItems              PrLineItem[]
  fundSource             FundSource?  @relation(fields: [fundSourceId], references: [id])
  requestedBySignatory   Signatory?   @relation("PrRequestedBy", fields: [requestedBySignatoryId], references: [id])
  requestedBy            User         @relation(fields: [requestedById], references: [id])
  office                 Office       @relation(fields: [officeId], references: [id])
  rfqs                   Rfq[]

  @@map("purchase_requests")
}

model PrLineItem {
  id          String          @id @default(cuid())
  prId        String
  itemId      String?
  description String
  unit        String
  quantity    Float
  unitCost    Float
  totalCost   Float
  sortOrder   Int             @default(0)
  item        Item?           @relation(fields: [itemId], references: [id])
  pr          PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@map("pr_line_items")
}

model Rfq {
  id            String               @id @default(cuid())
  rfqNumber     String               @unique
  prId          String
  deadline      DateTime?
  remarks       String?
  status        String               @default("DRAFT")
  printCount    Int                  @default(0)
  lastPrintedAt DateTime?
  fiscalYear    Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  signatoryId   String?
  aoq           AbstractOfQuotation?
  quotations    Quotation[]
  lineItems     RfqLineItem[]
  suppliers     RfqSupplier[]
  signatory     Signatory?           @relation(fields: [signatoryId], references: [id])
  pr            PurchaseRequest      @relation(fields: [prId], references: [id])

  @@map("rfqs")
}

model RfqSupplier {
  id         String   @id @default(cuid())
  rfqId      String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  rfq        Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, supplierId])
  @@map("rfq_suppliers")
}

model RfqLineItem {
  id                 String              @id @default(cuid())
  rfqId              String
  description        String
  unit               String
  quantity           Float
  unitCost           Float
  totalCost          Float
  sortOrder          Int                 @default(0)
  quotationLineItems QuotationLineItem[]
  rfq                Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_line_items")
}

model Quotation {
  id          String              @id @default(cuid())
  rfqId       String
  supplierId  String
  submittedAt DateTime?
  totalAmount Float               @default(0)
  remarks     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lineItems   QuotationLineItem[]
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  rfq         Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("quotations")
}

model QuotationLineItem {
  id            String      @id @default(cuid())
  quotationId   String
  rfqLineItemId String
  unitPrice     Float
  totalPrice    Float
  isLowest      Boolean     @default(false)
  remarks       String?
  rfqLineItem   RfqLineItem @relation(fields: [rfqLineItemId], references: [id])
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_line_items")
}

model AbstractOfQuotation {
  id             String          @id @default(cuid())
  aoqNumber      String          @unique
  rfqId          String          @unique
  recommendation String?
  totalAmount    Float           @default(0)
  status         String          @default("DRAFT")
  printCount     Int             @default(0)
  lastPrintedAt  DateTime?
  fiscalYear     Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rfq            Rfq             @relation(fields: [rfqId], references: [id])
  lineItems      AoqLineItem[]
  purchaseOrders PurchaseOrder[]

  @@map("abstracts_of_quotation")
}

model AoqLineItem {
  id               String              @id @default(cuid())
  aoqId            String
  description      String
  unit             String
  quantity         Float
  lowestUnitPrice  Float
  totalPrice       Float
  winnerSupplierId String?
  sortOrder        Int                 @default(0)
  aoq              AbstractOfQuotation @relation(fields: [aoqId], references: [id], onDelete: Cascade)

  @@map("aoq_line_items")
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  poNumber        String               @unique
  aoqId           String?
  supplierId      String?
  deliveryTerms   String?
  paymentTerms    String?
  placeOfDelivery String?
  deliveryDate    DateTime?
  totalAmount     Float                @default(0)
  status          String               @default("DRAFT")
  remarks         String?
  printCount      Int                  @default(0)
  lastPrintedAt   DateTime?
  fiscalYear      Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lineItems       PoLineItem[]
  acceptances     Acceptance[]
  supplier        Supplier?            @relation(fields: [supplierId], references: [id])
  aoq             AbstractOfQuotation? @relation(fields: [aoqId], references: [id])

  @@map("purchase_orders")
}

model PoLineItem {
  id          String        @id @default(cuid())
  poId        String
  description String
  unit        String
  quantity    Float
  unitPrice       Float
  totalPrice      Float
  sortOrder       Int                  @default(0)
  po              PurchaseOrder        @relation(fields: [poId], references: [id], onDelete: Cascade)
  acceptanceItems AcceptanceLineItem[]

  @@map("po_line_items")
}

model DocumentAuditLog {
  id           String   @id @default(cuid())
  documentType String
  documentId   String
  action       String
  userId       String
  notes        String?
  metadata     String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([documentType, documentId])
  @@index([userId])
  @@map("document_audit_log")
}

model Acceptance {
  id              String               @id @default(cuid())
  iarNumber       String               @unique
  poId            String
  invoiceNumber   String?
  invoiceDate     DateTime?
  dateReceived    DateTime?
  dateInspected   DateTime?
  status          String               @default("DRAFT")
  printCount      Int                  @default(0)
  fiscalYear      Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  po              PurchaseOrder        @relation(fields: [poId], references: [id])
  lineItems       AcceptanceLineItem[]

  @@map("acceptances")
}

model AcceptanceLineItem {
  id              String        @id @default(cuid())
  acceptanceId    String
  poLineItemId    String
  quantityDelivered Float       @default(0)
  
  acceptance      Acceptance    @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  poLineItem      PoLineItem    @relation(fields: [poLineItemId], references: [id])

  @@map("acceptance_line_items")
}
